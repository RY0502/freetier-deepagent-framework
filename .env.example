# ---- Provider API keys (rotated on quota exhaustion) ----
# Rotation order is fixed: ANYAPI -> REQUESTY -> NVIDIA -> OPENROUTER -> HUGGINGFACE
# AnyApi tries all configured keys before moving to Requesty.

ANYAPI_AGENT_KEY_1=your_anyapi_key_1_here
# ANYAPI_AGENT_KEY_2=your_anyapi_key_2_here
# ANYAPI_AGENT_KEY_3=your_anyapi_key_3_here
# ANYAPI_AGENT_KEY_4=your_anyapi_key_4_here
REQUESTY_API_KEY=your_requesty_api_key_here
NVIDIA_API_KEY=your_nvidia_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# ---- Model ids per provider ----
ANYAPI_DEEP_AGENT_MODEL=openai/gpt-5.5
NVIDIA_DEEP_AGENT_MODEL=z-ai/glm-5.2
REQUESTY_DEEP_AGENT_MODEL=nvidia/nemotron-3-super-120b-a12b
OPENROUTER_DEEP_AGENT_MODEL=nvidia/nemotron-3-super-120b-a12b
HUGGINGFACE_DEEP_AGENT_MODEL=zai-org/GLM-5.2

# ---- Provider base URLs (OpenAI-compatible chat completions) ----
ANYAPI_BASE_URL=https://api.anyapi.ai/v1
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
REQUESTY_BASE_URL=https://router.requesty.ai/v1
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
HUGGINGFACE_BASE_URL=https://router.huggingface.co/v1

# ---- Tavily (reuse from existing deep-agent repo) ----
TAVILY_API_KEY=your_tavily_api_key_here

# ---- Neon DB (reuse from existing deep-agent repo) ----
NEON_DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# ---- Vision / scrape agent ----
SCRAPE_AGENT_URL=https://scrape-agent.onrender.com

# ---- Audio generation via @freetier/orchestrator (Groq TTS) ----
# Add one or more keys; the orchestrator rotates across them on quota exhaustion.
GROQ_API_KEY_1=your_groq_api_key_here
# GROQ_API_KEY_2=your_second_groq_api_key_here
# GROQ_API_KEY_3=your_third_groq_api_key_here

# ---- Sub-agent concurrency ----
MAX_PARALLEL_SUBAGENTS=3

# ---- Provider retry/cooldown tuning ----
PROVIDER_RETRY_MAX=2
PROVIDER_RETRY_DELAY_MS=5000
PROVIDER_COOLDOWN_MS=120000
