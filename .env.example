# ---- Provider API keys (one key per provider, rotated on quota exhaustion) ----
# Rotation order is fixed: NVIDIA -> OPENROUTER -> HUGGINGFACE

NVIDIA_API_KEY=your_nvidia_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# ---- Model ids per provider ----
NVIDIA_DEEP_AGENT_MODEL=z-ai/glm-5.2
OPENROUTER_DEEP_AGENT_MODEL=z-ai/glm-5.2
HUGGINGFACE_DEEP_AGENT_MODEL=zai-org/GLM-5.2

# ---- Provider base URLs (OpenAI-compatible chat completions) ----
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
HUGGINGFACE_BASE_URL=https://router.huggingface.co/v1

# ---- Tavily (reuse from existing deep-agent repo) ----
TAVILY_API_KEY=your_tavily_api_key_here

# ---- Neon DB (reuse from existing deep-agent repo) ----
NEON_DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# ---- Vision / scrape agent ----
SCRAPE_AGENT_URL=https://scrape-agent.onrender.com

# ---- Sub-agent concurrency ----
MAX_PARALLEL_SUBAGENTS=3

# ---- Provider retry/cooldown tuning ----
PROVIDER_RETRY_MAX=2
PROVIDER_RETRY_DELAY_MS=5000
PROVIDER_COOLDOWN_MS=120000
